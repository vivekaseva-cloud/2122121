# ==============================================================================
# Hostinger (LiteSpeed & Apache) Production Configuration
# Optimized for Single-Page Applications (SPA), Fast Caching & Security
# ==============================================================================

# 1. Force UTF-8 Encoding
AddDefaultCharset UTF-8
DefaultLanguage te

# 2. Prevent Directory Browsing
Options -Indexes

# 3. Block Access to Hidden & Sensitive Files (.env, .git, etc.)
<FilesMatch "^\.">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>

# Allow access to .htaccess and robots.txt explicitly if required
<Files "robots.txt">
  <IfModule mod_authz_core.c>
    Require all granted
  </IfModule>
</Files>
<Files "sitemap.xml">
  <IfModule mod_authz_core.c>
    Require all granted
  </IfModule>
</Files>

# 4. HTTPS Redirection & SPA Routing (LiteSpeed / Apache)
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Automatically redirect HTTP to HTTPS on Hostinger
  RewriteCond %{HTTPS} off
  RewriteCond %{HTTP:X-Forwarded-Proto} !https
  RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # Don't rewrite existing files or directories
  RewriteRule ^index\.html$ - [L]
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Fallback to index.html for Single Page Routing
  RewriteRule ^ /index.html [L]
</IfModule>

# 5. Gzip & Deflate Compression (LiteSpeed / Apache)
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html
  AddOutputFilterByType DEFLATE text/plain
  AddOutputFilterByType DEFLATE text/xml
  AddOutputFilterByType DEFLATE text/css
  AddOutputFilterByType DEFLATE text/javascript
  AddOutputFilterByType DEFLATE application/javascript
  AddOutputFilterByType DEFLATE application/x-javascript
  AddOutputFilterByType DEFLATE application/json
  AddOutputFilterByType DEFLATE application/xml
  AddOutputFilterByType DEFLATE application/xhtml+xml
  AddOutputFilterByType DEFLATE application/rss+xml
  AddOutputFilterByType DEFLATE application/atom+xml
  AddOutputFilterByType DEFLATE image/svg+xml
  AddOutputFilterByType DEFLATE font/ttf
  AddOutputFilterByType DEFLATE font/otf
  AddOutputFilterByType DEFLATE font/woff
  AddOutputFilterByType DEFLATE font/woff2
</IfModule>

# 6. Browser Caching (LiteSpeed Cache / mod_expires)
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 1 month"

  # HTML: Cache for 1 hour so content/video updates reflect quickly
  ExpiresByType text/html "access plus 1 hour"

  # CSS & JavaScript: 1 year (cache busting handles changes)
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType text/javascript "access plus 1 year"

  # Media & Images: 1 year
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/jpg "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/gif "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType image/x-icon "access plus 1 year"

  # Fonts
  ExpiresByType font/ttf "access plus 1 year"
  ExpiresByType font/otf "access plus 1 year"
  ExpiresByType font/woff "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
</IfModule>

# 7. Security Headers
<IfModule mod_headers.c>
  # Prevent MIME type sniffing
  Header set X-Content-Type-Options "nosniff"

  # Cross-site scripting (XSS) filter
  Header set X-XSS-Protection "1; mode=block"

  # Referrer policy
  Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
